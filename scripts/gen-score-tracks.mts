/* Writes server/api/scores-tracks.php: per race map the driven length and 16 checkpoints (x, z, radius) that a
 * submitted best lap must pass in order (server/api/scores-lib.php). Run after changing a map:
 * `npx tsx scripts/gen-score-tracks.mts`; tests/scores-tracks-check.mts fails while the file is stale. */
import { writeFileSync } from 'node:fs';
import { TRACKS, buildTrack } from '../src/data/tracks/index.ts';
import { halfWidthAt } from '../src/world/track.ts';

export const CHECKPOINTS = 16;
/** Metres beyond the drivable half width that still count as "at the checkpoint". */
const MARGIN = 4;

export function scoreTracksPhp(): string {
  const rows: string[] = [];
  for (const def of TRACKS) {
    if (def.type === 'drift') continue; // drift maps are scored by points, not on the lap boards
    const tr = buildTrack(def);
    const n = def.type === 'sprint' ? tr.raceSamples : tr.samples.length;
    const cps: string[] = [];
    for (let k = 0; k < CHECKPOINTS; k++) {
      const i = Math.min(n - 1, Math.round((k * n) / CHECKPOINTS));
      const p = tr.samples[i].position;
      cps.push(`[${p.x.toFixed(1)}, ${p.z.toFixed(1)}, ${(halfWidthAt(tr, i) + MARGIN).toFixed(1)}]`);
    }
    rows.push(`  '${def.id}' => ['type' => '${def.type}', 'len' => ${(n * tr.spacing).toFixed(0)}, 'cps' => [${cps.join(', ')}]],`);
  }
  return `<?php
// GENERATED by scripts/gen-score-tracks.mts from src/data/tracks: do not edit. Lap boards: length (m) and checkpoints [x, z, r].
if (realpath($_SERVER['SCRIPT_FILENAME'] ?? '') === __FILE__) { http_response_code(404); exit; }
return [
${rows.join('\n')}
];
`;
}

if (process.argv[1]?.endsWith('gen-score-tracks.mts')) {
  writeFileSync('server/api/scores-tracks.php', scoreTracksPhp());
  console.log('wrote server/api/scores-tracks.php');
}
