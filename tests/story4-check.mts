import { chapter3Complete, chapter4Complete, chapter4Open, completeEvent, isUnlocked, nextEvent, nextEvent3, nextEvent4 } from '../src/core/career.ts';
import { defaultSave, SaveStore, type KeyValueStore } from '../src/core/save.ts';
import { CARS } from '../src/data/cars.ts';
import { RIVALS } from '../src/data/rivals.ts';
import { SPEAKERS } from '../src/data/story.ts';
import { EVERY_EVENT, eventsOf } from '../src/data/story2.ts';
import { EVENTS_4, EPILOGUE_4 } from '../src/data/story4.ts';
import { TRACKS } from '../src/data/tracks/index.ts';
import { tx } from '../src/i18n/index.ts';
import { ES_CONTENT } from '../src/i18n/esContent.ts';

let failed = 0;
const check = (n: string, ok: boolean, i = ''): void => { if (!ok) failed++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}  (${i})`); };
const mem: Record<string, string> = {};
const kv: KeyValueStore = { getItem: (k) => mem[k] ?? null, setItem: (k, v) => void (mem[k] = v) };
const s = new SaveStore(kv, defaultSave('civic', 0xffffff), CARS.map((x) => x.id));
check('four events, unique ids, chapter 4', EVENTS_4.length === 4 && eventsOf(4).length === 4 && new Set(EVERY_EVENT.map((e) => e.id)).size === EVERY_EVENT.length);
check('spread over four different maps', new Set(EVENTS_4.map((e) => e.trackId)).size === 4);
check('maps exist, drift sits on drift maps and uses its target', EVENTS_4.every((e) => { const t = TRACKS.find((x) => x.id === e.trackId); return !!t && (e.kind === 'drift') === (t.type === 'drift') && (e.kind !== 'drift' || e.driftTarget === t.driftTarget); }));
const ids = new Set(RIVALS.map((r) => r.id));
check('rivals exist', EVENTS_4.every((e) => e.rivals.every((r) => ids.has(r))));
const all = EVENTS_4.flatMap((e) => [...e.before, ...e.afterWin, ...e.afterLose, ...(e.loseAlt ?? []).flat()]);
check('speakers known, lines short', all.every((l) => !!SPEAKERS[l.who] && l.text.length < 260));
check('three lose variants per event', EVENTS_4.every((e) => 1 + (e.loseAlt?.length ?? 0) >= 3));
const texts = [...EVENTS_4.flatMap((e) => [e.title, e.blurb, e.card]), ...all.map((l) => l.text), EPILOGUE_4.title, EPILOGUE_4.text, ...EPILOGUE_4.credits.slice(1)];
const missing = texts.filter((x) => !ES_CONTENT[x] && !ES_CONTENT[x.replace(/’/g, "'")]);
check('every chapter 4 text has Spanish', missing.length === 0, missing.slice(0, 2).join(' | '));
void tx;
check('locked on a new career', !chapter4Open(s.data.career) && nextEvent4(s.data.career) === null && !isUnlocked(s.data.career, 'c4-yard'));
for (let n = 0, e = nextEvent(s.data.career); e && n < 50; n++, e = nextEvent(s.data.career)) completeEvent(s.data, e);
s.data.career.epilogueSeen = true;
for (let n = 0, e = nextEvent3(s.data.career); e && n < 20; n++, e = nextEvent3(s.data.career)) completeEvent(s.data, e);
check('chapter 3 done alone does not open chapter 4', chapter3Complete(s.data.career) && !chapter4Open(s.data.career));
s.data.career.flags.c3Seen = true;
check('after the chapter 3 ending the first chapter 4 event opens', nextEvent4(s.data.career)?.id === 'c4-yard' && isUnlocked(s.data.career, 'c4-yard') && !isUnlocked(s.data.career, 'c4-cranes'));
const seen: string[] = [];
for (let n = 0, e = nextEvent4(s.data.career); e && n < 20; n++, e = nextEvent4(s.data.career)) { seen.push(e.id); completeEvent(s.data, e); }
check('walked in order and ends', seen.join() === EVENTS_4.map((e) => e.id).join() && chapter4Complete(s.data.career));
console.log(failed ? `FAILED ${failed}` : 'ALL PASS');
process.exit(failed ? 1 : 0);
