import { lapPop } from '../src/game/lapPop.ts';
let failed = 0;
const check = (n: string, ok: boolean, d = ''): void => { console.log(`${ok ? 'PASS' : 'FAIL'} ${n}${d ? ' - ' + d : ''}`); if (!ok) failed++; };
const a = lapPop('LAP 1', 84.1, null);
check('no best: time only, neutral colour', a.text === 'LAP 1  1:24.10' && !a.color.includes('--'), a.text);
const b = lapPop('LAP 2', 84.41, 84.1);
check('slower: plus, red', b.text === 'LAP 2  1:24.41  +0.31' && b.color === 'var(--red)', b.text);
const c = lapPop('LAP 3', 83.68, 84.1);
check('faster: minus, green', c.text === 'LAP 3  1:23.68  −0.42' && c.color === 'var(--green)', c.text);
const d = lapPop('LAP 4', 84.1001, 84.1);
check('tie: minus zero, green', d.text.endsWith('−0.00') && d.color === 'var(--green)', d.text);
check('seconds pad (1:05.03)', lapPop('L', 65.03, null).text === 'L  1:05.03');
check('bad best ignored', lapPop('L', 70, NaN).text === 'L  1:10.00' && lapPop('L', 70, -1).text === 'L  1:10.00');
check('new best label keeps time and gain', lapPop('NEW BEST LAP', 83.5, 84.1).text === 'NEW BEST LAP  1:23.50  −0.60' && lapPop('NEW BEST LAP', 83.5, null).text === 'NEW BEST LAP  1:23.50');
if (failed) process.exit(1);
