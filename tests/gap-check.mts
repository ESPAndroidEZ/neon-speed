import { computeGaps, newGaps } from '../src/game/gapLogic.ts';
import type { Racer } from '../src/core/raceResult.ts';
let failed = 0;
const check = (n: string, ok: boolean, d = ''): void => { console.log(`${ok ? 'PASS' : 'FAIL'} ${n}${d ? ' - ' + d : ''}`); if (!ok) failed++; };
const mk = (total: number, speed: number, finished = false): Racer => ({ laps: { total }, car: { state: { speed } }, finished } as unknown as Racer);
const me = mk(100, 30), a = mk(110, 30), b = mk(90, 30), far = mk(200, 30), done = mk(105, 30, true);
const g = computeGaps([me, far, a, b, done], me, 3, newGaps());
check('nearest ahead is picked, finished racers skipped', g.ahead === 2, String(g.ahead));
check('gap ahead = 30 m at 30 m/s = 1 s', Math.abs(g.aheadSec - 1) < 1e-9, String(g.aheadSec));
check('nearest behind is picked', g.behind === 3 && Math.abs(g.behindSec - 1) < 1e-9);
const alone = computeGaps([me], me, 3, newGaps());
check('alone: no gaps', alone.ahead === -1 && alone.behind === -1);
const lead = computeGaps([me, b], me, 3, newGaps());
check('leading: only behind', lead.ahead === -1 && lead.behind === 1);
const slow = computeGaps([mk(100, 0), mk(103, 0)], mk(100, 0), 3, newGaps());
check('standing start stays finite (speed floor)', Number.isFinite(slow.aheadSec) || slow.ahead === -1);
const tie = computeGaps([me, mk(100, 30)], me, 3, newGaps());
check('level racer counts as behind, gap 0', tie.behind === 1 && tie.behindSec === 0);
if (failed) process.exit(1);
