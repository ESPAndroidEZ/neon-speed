import { newPadNav, PAD_DOWN, PAD_OK, PAD_UP, padBits, primePadNav, stepPadNav } from '../src/input/padNavLogic.ts';
let failed = 0;
const check = (n: string, ok: boolean, d = ''): void => { console.log(`${ok ? 'PASS' : 'FAIL'} ${n}${d ? ' - ' + d : ''}`); if (!ok) failed++; };
const btn = (...down: number[]) => Array.from({ length: 16 }, (_, i) => ({ pressed: down.includes(i) }));
check('d-pad down gives DOWN', padBits(btn(13), [0, 0]) === PAD_DOWN);
check('stick up gives UP', padBits(btn(), [0, -0.9]) === PAD_UP);
check('stick inside the dead zone gives nothing', padBits(btn(), [0.3, -0.5]) === 0);
check('A gives OK', padBits(btn(0), []) === PAD_OK);
let s = newPadNav();
check('a press fires once', stepPadNav(s, 1 / 60, PAD_DOWN) === PAD_DOWN && stepPadNav(s, 1 / 60, PAD_DOWN) === 0);
let fires = 0;
for (let i = 0; i < 60; i++) if (stepPadNav(s, 1 / 60, PAD_DOWN)) fires++;
check('holding repeats after the delay (about 4 in the next second)', fires >= 3 && fires <= 6, String(fires));
s = newPadNav();
stepPadNav(s, 1 / 60, PAD_DOWN);
check('release then press fires again', stepPadNav(s, 1 / 60, 0) === 0 && stepPadNav(s, 1 / 60, PAD_DOWN) === PAD_DOWN);
s = newPadNav();
primePadNav(s, PAD_OK);
check('a button held when the menu opens does not fire', stepPadNav(s, 1 / 60, PAD_OK) === 0);
check('A never repeats while held', (() => { let n = 0; for (let i = 0; i < 120; i++) n += stepPadNav(s, 1 / 60, PAD_OK) & PAD_OK ? 1 : 0; return n === 0; })());
if (failed) process.exit(1);
