// Measures each upgrade's real effect: the full-skill AI's lap on Kestrel Bay (CLEAR) per car, stock vs that category at
// level 3. Writes logs/upgrade-impact.ts (lab only: the AI driver is not a fair judge of upgrades yet) (seconds per lap, negative = faster). Re-run after handling or upgrade changes:
//   npx tsx scripts/upgrade-impact.mts
import { writeFileSync } from 'node:fs';
import { CARS } from '../../src/data/cars.ts';
import { UPGRADES, applyUpgrades, type UpgradeId } from '../../src/data/upgrades.ts';
import { RaceManager } from '../../src/core/raceManager.ts';
import { applyTuning, createDefaultTuning } from '../../src/physics/carTuning.ts';
import { createAIRacer } from '../../src/physics/aiRacers.ts';
import { createKestrelBay } from '../../src/world/kestrelBay.ts';
import { createNeutralInput } from '../../src/types/game.ts';
const track = createKestrelBay();
function lap(carId: string, up?: UpgradeId): number {
  const t = applyTuning(createDefaultTuning(), CARS.find((c) => c.id === carId)!.tuning);
  if (up) applyUpgrades(t, { [up]: 3 });
  const rm = new RaceManager(track, 2);
  rm.addRacer('ai', 'AI', t, createAIRacer('ai', 'AI', 1));
  rm.addRacer('you', 'You', createDefaultTuning(), null, true);
  rm.start();
  const idle = createNeutralInput();
  let n = 0;
  while (!rm.racers[0].finished && n++ < 60 * 400) rm.step(1 / 60, idle, 'CLEAR');
  return rm.racers[0].finished ? rm.racers[0].finishTime / 2 : 999;
}
const out: Record<string, Record<string, number>> = {};
for (const c of CARS) {
  const base = lap(c.id);
  out[c.id] = { stock: Math.round(base * 10) / 10 };
  for (const u of UPGRADES) {
    if (u.needs === 'turbo' && !(c.tuning.turboTorque ?? 0)) continue;
    out[c.id][u.id] = Math.round((lap(c.id, u.id) - base) * 10) / 10;
  }
  console.log(c.id, JSON.stringify(out[c.id]));
}
writeFileSync('logs/upgrade-impact.ts', `/* GENERATED by scripts/upgrade-impact.mts: full-skill AI lap on Kestrel Bay (CLEAR), stock lap in seconds and the
   change per lap with each upgrade category at level 3 (negative = faster). Measured, not estimated. */
export const UPGRADE_IMPACT: Readonly<Record<string, Readonly<Record<string, number>>>> = ${JSON.stringify(out, null, 1)};
`);
