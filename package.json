{
  "name": "nfs-underground-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-lines.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:lines": "node scripts/check-lines.mjs",
    "preview": "vite preview",
    "test": "for f in tests/*.mts; do npx tsx \"$f\" || exit 1; done"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
