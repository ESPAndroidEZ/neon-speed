{
  "name": "nfs-underground-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-lines.mjs && node scripts/check-health.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:lines": "node scripts/check-lines.mjs",
    "preview": "vite preview",
    "test": "for f in tests/*.mts; do npx tsx \"$f\" || exit 1; done",
    "smoke": "scripts/smoke.sh",
    "handling": "tsx tests/lab/handling-lab.mts",
    "visual": "node scripts/visual-check.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
