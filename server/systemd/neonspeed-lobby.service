[Unit]
Description=Neon Speed: online race lobby (WebSocket switchboard on 127.0.0.1:8770, nginx /ws/)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/neonspeed-lobby/lobby.py --host 127.0.0.1 --port 8770
WorkingDirectory=/opt/neonspeed-lobby
DynamicUser=yes
Restart=on-failure
RestartSec=3
MemoryMax=128M
TasksMax=32
LimitNOFILE=1024
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
