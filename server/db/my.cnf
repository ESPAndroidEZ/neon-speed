# Neon Speed: its own single-node MySQL 8.0 (the installed Percona build with the cluster switched off).
# Separate datadir, port 3307, localhost only, small memory. Read with --defaults-file: nothing from /etc/mysql/conf.d is used.
[mysqld]
user = mysql
datadir = /var/lib/neonspeed-mysql
socket = /run/neonspeed-mysql/mysqld.sock
pid-file = /run/neonspeed-mysql/mysqld.pid
log-error = /var/lib/neonspeed-mysql/error.log
port = 3307
bind-address = 127.0.0.1
mysqlx = OFF
skip-name-resolve
wsrep_provider = none
pxc_strict_mode = DISABLED
disable-log-bin
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
performance_schema = OFF
innodb_buffer_pool_size = 64M
innodb_redo_log_capacity = 33554432
max_connections = 30
table_open_cache = 64
tmp_table_size = 16M
max_heap_table_size = 16M
